---
import { supabase } from '../../lib/supabase';

const { id } = Astro.params;

// Fetch details for this specific species AND its linked papers on demand
const { data: species, error } = await supabase
  .from('species')
  .select('*, papers(*)')
  .eq('id', id)
  .single();

if (error || !species) {
  return Astro.redirect('/404');
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{species.common_name} ({species.scientific_name}) - Technical Profile</title>
</head>
<body style="font-family: system-ui, sans-serif; padding: 2rem; max-width: 900px; margin: 0 auto; line-height: 1.6; background: #fafafa; color: #111;">
  <a href="/" style="color: #2563eb; text-decoration: none; font-weight: bold;">&larr; Back to Database Home</a>

  <header style="margin-top: 1.5rem; border-bottom: 2px solid #e5e7eb; padding-bottom: 1rem;">
    <h1 style="margin: 0;">{species.common_name}</h1>
    <p style="font-style: italic; font-size: 1.25rem; color: #4b5563; margin-top: 0.25rem;">
      {species.scientific_name}
    </p>

    {species.conservation_status && (
      <span style="display: inline-block; background: #fef3c7; color: #92400e; padding: 0.25rem 0.75rem; border-radius: 9999px; font-weight: bold; font-size: 0.875rem;">
        IUCN Status: {species.conservation_status}
      </span>
    )}
  </header>

  <main style="margin-top: 2rem;">
    <!-- Technical Specifications Section -->
    <section style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem;">
      <h2 style="margin-top: 0;">Technical Profile</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <div>
          <strong>Family:</strong> {species.family || 'Unclassified'}
        </div>
        <div>
          <strong>Habitat/Biome:</strong> {species.habitat_biome || 'N/A'}
        </div>
      </div>

      {species.technical_notes && (
        <div style="margin-top: 1rem;">
          <strong>Technical Notes:</strong>
          <p style="margin-top: 0.5rem; color: #374151;">{species.technical_notes}</p>
        </div>
      )}
    </section>

    <!-- Scientific Papers Section -->
    <section>
      <h2>Published Scientific Studies ({species.papers?.length || 0})</h2>

      {(!species.papers || species.papers.length === 0) ? (
        <p style="color: #6b7280; font-style: italic;">No scientific papers linked to this species yet.</p>
      ) : (
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {species.papers.map((paper) => (
            <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 1.25rem;">
              <h3 style="margin: 0 0 0.5rem 0; font-size: 1.1rem; color: #1e3a8a;">{paper.title}</h3>
              <p style="margin: 0; font-size: 0.9rem; color: #4b5563;">
                <strong>Authors:</strong> {paper.authors || 'Unknown'} ({paper.publication_year || 'N/A'})
              </p>
              {paper.journal && <p style="margin: 0.25rem 0; font-size: 0.875rem; color: #6b7280;"><em>{paper.journal}</em></p>}
              
              {paper.summary && <p style="font-size: 0.95rem; margin-top: 0.75rem; color: #374151;">{paper.summary}</p>}

              {paper.doi && (
                <a href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer" style="display: inline-block; margin-top: 0.5rem; color: #2563eb; font-size: 0.875rem; font-weight: bold;">
                  View Paper DOI &rarr;
                </a>
              )}
            </div>
          ))}
        </div>
      )}
    </section>
  </main>
</body>
</html>